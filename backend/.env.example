# Copy to /opt/backend/.env and pass with:  docker run --env-file /opt/backend/.env ...
# Never commit the real .env.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Profile (optional) - used by the dashboard (BMI, waist-to-height, goal) and the AI coach
USER_NAME=
HEIGHT_CM=
TARGET_WEIGHT_KG=
BIRTH_DATE=          # YYYY-MM-DD
SEX=                 # male / female

# Local time (fixed offset from UTC)
TZ_OFFSET_HOURS=10
TZ_NAME=local
